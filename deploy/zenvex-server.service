[Unit]
Description=Zenvex Online oyun sunucusu
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/zenvex/server.env
ExecStart=/opt/zenvex/zenvex_server
Restart=always
RestartSec=2
User=zenvex
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
