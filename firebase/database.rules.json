{
  "rules": {
    "presence": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 's', 'ts']) && newData.child('n').isString() && newData.child('n').val().length <= 24"
        }
      }
    },
    "chat": {
      "$channel": {
        ".read": "auth != null",
        ".indexOn": [
          "ts"
        ],
        "$msg": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.child('u').val() === auth.uid && newData.child('m').isString() && newData.child('m').val().length <= 140 && newData.child('n').isString()"
        }
      }
    },
    "world": {
      "$room": {
        ".read": "auth != null",
        "z": {
          ".write": "auth != null"
        },
        "hits": {
          "$h": {
            ".write": "auth != null"
          }
        },
        "kills": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$k": {
              ".write": "auth != null"
            }
          }
        },
        "pdmg": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$k": {
              ".write": "auth != null"
            }
          }
        }
      }
    },
    "trade_req": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)"
        }
      }
    },
    "trade": {
      "$sid": {
        ".read": "auth != null && $sid.contains(auth.uid)",
        ".write": "auth != null && $sid.contains(auth.uid)"
      }
    }
  }
}